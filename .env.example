# ──────────────────────────────────────────────────────────────────────────────
# JobFlow — environment configuration example
# Copy this file to .env and fill in real values before starting the stack.
# Never commit .env — it is listed in .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Username for the PostgreSQL database
POSTGRES_USER=jobflow

# Password for the PostgreSQL database user  [REQUIRED — change before running]
POSTGRES_PASSWORD=change_me_before_running

# Database name
POSTGRES_DB=jobflow

# ── Backend ───────────────────────────────────────────────────────────────────
# Full connection string used by the Node backend (and Drizzle) to reach Postgres.
# In Docker Compose: hostname is the Compose service name "postgres".
# For local development without Docker: use localhost.
DATABASE_URL=postgresql://jobflow:change_me_before_running@postgres:5432/jobflow
