# ──────────────────────────────────────────────────────────────────────────────
# JobFlow — environment configuration example
# Copy this file to .env and fill in real values before starting the stack.
# Never commit .env — it is listed in .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Username for the PostgreSQL database
POSTGRES_USER=jobflow

# Password for the PostgreSQL database user  [REQUIRED — change before running]
POSTGRES_PASSWORD=change_me_before_running

# Database name
POSTGRES_DB=jobflow

# ── Host-side commands only ──────────────────────────────────────────────────
# Docker Compose does NOT read this value: it builds the backend container's
# DATABASE_URL itself from the POSTGRES_* values above, using the Compose
# service hostname "postgres" (see docker-compose.yml).
#
# This DATABASE_URL is for commands run directly on the host (backend without
# Docker, drizzle-kit), which reach Postgres through the localhost-published
# port 5432. Keep user/password/db in sync with the POSTGRES_* values above.
DATABASE_URL=postgresql://jobflow:change_me_before_running@localhost:5432/jobflow
